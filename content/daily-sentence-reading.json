{
  "day-05-s5-i1": {
    "narrationId": "daily-word-day-05-s5-i1",
    "spokenText": "弟弟哭了。"
  },
  "day-05-s5-i2": {
    "narrationId": "daily-sentence-day-05-s5-i2",
    "spokenText": "妈妈拖地。"
  },
  "day-06-s6-i1": {
    "narrationId": "daily-word-day-06-s6-i1",
    "spokenText": "弟弟画图画，哥哥举国旗。"
  },
  "day-06-s6-i2": {
    "narrationId": "daily-word-day-06-s6-i2",
    "spokenText": "爸爸下棋，妈妈洗衣服，哥哥和弟弟搭积木。"
  },
  "day-07-s6-i1": {
    "narrationId": "daily-word-day-07-s6-i1",
    "spokenText": "上午，爸爸拖地，妈妈洗衣服，哥哥擦玻璃，弟弟画画，我做贺卡。"
  },
  "day-10-s6-i1": {
    "narrationId": "daily-word-day-10-s6-i1",
    "spokenText": "奶奶买了白菜。"
  },
  "day-10-s6-i2": {
    "narrationId": "daily-word-day-10-s6-i2",
    "spokenText": "妹妹爱吃西瓜。"
  },
  "day-10-s6-i3": {
    "narrationId": "daily-word-day-10-s6-i3",
    "spokenText": "弟弟背着一个大水壶。"
  },
  "day-10-s6-i4": {
    "narrationId": "daily-word-day-10-s6-i4",
    "spokenText": "妈妈的手上拿着果皮。"
  },
  "day-11-s6-i8": {
    "narrationId": "daily-sentence-day-11-s6-i8",
    "spokenText": "喵喵喵，小猫叫。"
  },
  "day-11-s6-i9": {
    "narrationId": "daily-word-day-11-s6-i9",
    "spokenText": "舅舅是优秀的老师。"
  },
  "day-11-s6-i10": {
    "narrationId": "daily-word-day-11-s6-i10",
    "spokenText": "牛妈妈驮着牛宝宝做游戏。"
  },
  "day-12-s7-i7": {
    "narrationId": "daily-sentence-day-12-s7-i7",
    "spokenText": "喜鹊枝头叫，喜事就来到。"
  },
  "day-12-s7-i8": {
    "narrationId": "daily-word-day-12-s7-i8",
    "spokenText": "小鸭扭扭腰，撅着屁股过小桥。"
  },
  "day-12-s7-i9": {
    "narrationId": "daily-word-day-12-s7-i9",
    "spokenText": "爷爷坐着摇摇椅，戴着耳机睡着了。"
  },
  "day-13-s7-i5": {
    "narrationId": "daily-sentence-day-13-s7-i5",
    "spokenText": "我每天都去爬山。"
  },
  "day-13-s7-i6": {
    "narrationId": "daily-sentence-day-13-s7-i6",
    "spokenText": "我们都爱读语文课本。"
  },
  "day-13-s7-i7": {
    "narrationId": "daily-sentence-day-13-s7-i7",
    "spokenText": "蓝蓝的天上白云飘。"
  },
  "day-14-s7-i7": {
    "narrationId": "daily-sentence-day-14-s7-i7",
    "spokenText": "我们上学去。"
  },
  "day-14-s7-i8": {
    "narrationId": "daily-sentence-day-14-s7-i8",
    "spokenText": "老师是辛勤的园丁。"
  },
  "day-14-s7-i9": {
    "narrationId": "daily-sentence-day-14-s7-i9",
    "spokenText": "他是中国人，我也是中国人。"
  }
}
