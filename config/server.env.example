# Copy to private/server.env after preparing a trusted LAN certificate.
# Replace this example IP and paths with this Mac's values.
# Literal KEY=value only: no quotes, variable expansion, or shell commands.
# Paths are relative to the repository root; absolute paths also work.
LOVE_PINYIN_BIND_IP=192.168.1.20
LOVE_PINYIN_TLS_CERT=certs/lan.pem
LOVE_PINYIN_TLS_KEY=certs/lan-key.pem
LOVE_PINYIN_PORT=8000
LOVE_PINYIN_HTTPS_PORT=8443
